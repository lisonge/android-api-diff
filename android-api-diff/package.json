{
  "name": "android-api-diff",
  "version": "0.6.1",
  "description": "Inspect Android framework API changes and generate hidden-API Java code",
  "type": "module",
  "keywords": [
    "android",
    "api",
    "diff",
    "cli",
    "hidden-api"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lisonge/android-api-diff",
    "directory": "android-api-diff"
  },
  "engines": {
    "node": ">=26.5.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "bin": {
      "android-api-diff": "./dist/cli.js"
    },
    "exports": {
      ".": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "android-api-diff": "./src/cli/index.ts"
  },
  "scripts": {
    "build": "pnpm -w prepare:assets && tsdown",
    "prepublishOnly": "pnpm build",
    "start": "pnpm -w prepare:assets && node src/cli/index.ts",
    "test:cli": "node --test src/cli/cli.test.ts",
    "test:cache": "node --test src/node/nodeRuntime.test.ts src/node/nodeNetwork.test.ts",
    "type-check": "tsc",
    "test:code-render": "node scripts/code-render.test.ts",
    "test:query": "node scripts/query.test.ts",
    "build:index": "node scripts/build-index.ts",
    "test:index": "pnpm prepare:index && node --test scripts/source-index.test.ts",
    "test:nullability": "node scripts/parser/nullability.test.ts",
    "test:constant-expression": "node --test scripts/parser/constant-expression.test.ts scripts/parser/constant-expression-regression.test.ts",
    "test:aidl": "node --test scripts/parser/aidl.test.ts",
    "test:java": "node --test scripts/parser/java-regression.test.ts",
    "bench:java": "node scripts/parser/java-benchmark.ts",
    "test:parser": "node --test scripts/parser/nullability.test.ts scripts/parser/constant-expression.test.ts scripts/parser/constant-expression-regression.test.ts scripts/parser/aidl.test.ts scripts/parser/java-regression.test.ts",
    "test:package": "pnpm build && node --test scripts/package.test.ts",
    "prepare:index": "node ../scripts/prepare-index.ts"
  },
  "dependencies": {
    "p-limit": "catalog:",
    "skills": "catalog:",
    "web-tree-sitter": "catalog:",
    "aidl-parser": "catalog:"
  },
  "exports": {
    ".": "./src/core/index.ts"
  }
}
