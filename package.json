{
  "name": "android-api-diff-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "type-check": "pnpm -r type-check && tsc -p scripts/tsconfig.json",
    "dev": "pnpm -F android-api-diff-web dev",
    "build": "pnpm -F android-api-diff-web build",
    "preview": "pnpm -F android-api-diff-web preview",
    "format": "prettier --cache --write --ignore-unknown .",
    "test:unit": "pnpm prepare:index && node scripts/test.mjs",
    "test": "pnpm type-check && pnpm test:unit && pnpm -F android-api-diff test:package",
    "prepare:index": "node scripts/prepare-index.ts",
    "upload:index": "node scripts/upload-index.ts"
  },
  "dependencies": {
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-legacy": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vueuse/core": "catalog:",
    "idb": "catalog:",
    "lodash-es": "catalog:",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:",
    "user-attachments": "catalog:",
    "tailwindcss": "catalog:",
    "@tailwindcss/vite": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.5.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.17.0",
      "onFail": "error"
    }
  }
}
